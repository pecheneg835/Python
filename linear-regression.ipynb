   "source": [
    "import numpy as np\n",
    "\n",
    "def predict(X, w, b):\n",
    "    return w * X + b\n",
    "\n",
    "X = np.array([30, 40, 50, 60, 70])\n",
    "w  = 0.2\n",
    "b = 0\n",
    "\n",
    "print(predict(X, w, b))\n",
    "\n",
    "X = np.array([6, 8, 10, 12, 14])\n",
    "\n",
    "print(predict(X, 0.1, 3))"
   ]
  }
